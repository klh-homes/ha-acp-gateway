# Companion env file for examples/docker-compose.example.yaml.
# Copy to .env in the deployment repo, fill in, and reference from compose.

# Shared across all personas — one Anthropic account is fine.
CLAUDE_CODE_OAUTH_TOKEN=

# One per persona deployment. Generate fresh values:
#   openssl rand -hex 32
JARVIS_BEARER_TOKEN=
FRIDAY_BEARER_TOKEN=
