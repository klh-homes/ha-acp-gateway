{
  "name": "@klh-homes/ha-acp-gateway-service",
  "version": "0.2.0",
  "private": true,
  "description": "Gateway service that bridges Home Assistant's Assist pipeline to ACP-speaking coding agents (Claude, Codex, ...).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.33.1",
    "@agentclientprotocol/sdk": "^0.21.0",
    "@hono/node-server": "^2.0.2",
    "hono": "^4.12.18",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.7.0",
    "eslint": "^10.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  }
}
