{
  "name": "@klh-homes/ha-acp-gateway-service",
  "version": "0.2.1",
  "private": true,
  "description": "Gateway service that bridges Home Assistant's Assist pipeline to ACP-speaking coding agents (Claude, Codex, ...).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.100.0",
    "@agentclientprotocol/sdk": "^2.4.0",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
