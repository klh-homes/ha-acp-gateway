# --- Required (V1) ---

# OAuth token for @anthropic-ai/claude-code. Obtain via `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=

# Shared secret. HA sends this as `Authorization: Bearer <token>` on /v1/converse.
BEARER_TOKEN=

# ha-mcp HTTP endpoint, e.g. http://ha-mcp.lan:3000/mcp
HA_MCP_URL=

# Long-lived access token for ha-mcp to call back into Home Assistant.
HA_LONG_LIVED_TOKEN=

# --- Optional ---

PORT=8765
SESSION_IDLE_TTL_SEC=1800
MAX_CONCURRENT_SESSIONS=8
LOG_LEVEL=info
