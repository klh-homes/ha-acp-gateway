# Service-level configuration. One .env per deployed persona.
#
# Persona-specific behavior (system prompt, MCP servers, model selection) is
# NOT here — it lives in the mounted persona directory. See
# docs/ARCHITECTURE.md and examples/personas/ for the layout.

# --- Required ---

# OAuth token read by @anthropic-ai/claude-agent-sdk (which the
# claude-agent-acp adapter spawns under the hood). Obtain via
# `claude setup-token` from a machine with the Claude CLI installed.
# The same token can be shared across persona deployments — usage hits the
# same Anthropic account quota either way.
CLAUDE_CODE_OAUTH_TOKEN=

# Shared secret. HA sends this as `Authorization: Bearer <token>` on
# /v1/converse. Use a different value per deployment so a leak only affects
# one persona.
BEARER_TOKEN=

# Path to the persona directory mounted into the container. The service
# spawns claude-agent-acp with HOME set to this path; the adapter reads its
# native Claude Code config from $HOME/.claude/ (CLAUDE.md, settings.json,
# skills/, etc.). An empty directory is valid — the adapter falls back to
# defaults (Sonnet 4.6, no MCP). Defaults to /home/node to overlap with
# the container's $HOME; see docs/ARCHITECTURE.md.
PERSONA_DIR=/home/node

# --- Optional ---

PORT=8765
LOG_LEVEL=info
MAX_CONCURRENT_SESSIONS=8

# Idle eviction: drop a session that hasn't served a request for this
# many seconds (default 1800 = 30 min, matches Anthropic prompt cache TTL).
SESSION_IDLE_TTL_SEC=1800

# Force-evict a session past this total lifetime in seconds, regardless of
# activity. 0 (default) = no max age; idle TTL is the only trigger.
# Recommended when SESSION_AFFINITY=entity to prevent Claude's context
# from accumulating indefinitely. e.g. 14400 = 4 hours.
SESSION_MAX_AGE_SEC=0

# "conversation" (default): pool keys on the incoming conversation_id;
# HA's Assist conversations control reuse, fresh wake-words cold-start.
# "entity": every request collapses to a single shared session per
# service process. After the first turn primes the prompt cache, every
# subsequent request hits warm cache — eliminates the ~10s cold-start
# voice users feel on each wake word. Trade-off: Claude remembers prior
# unrelated conversations until SESSION_IDLE_TTL or SESSION_MAX_AGE fires.
# Set SESSION_MAX_AGE_SEC alongside this so context can't accumulate
# without bound.
SESSION_AFFINITY=conversation
